# Copy this file to .env and fill in your Firebase project's web app config.
# Find these values in: Firebase Console > Project settings > General > Your apps > SDK setup and configuration.
#
# If you leave these unset (or leave the YOUR_... placeholders), CoopConnect
# automatically runs in DEMO MODE: authentication uses a local, in-browser
# system with three seeded demo accounts (see src/lib/demoAuth.js) instead of
# a real Firebase project. This lets you run and demo the app with zero setup.
# Demo mode is clearly labeled in the UI and is not production-secure.

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# Backend API base URL (used from Part 2 onward, for the FastAPI backend).
VITE_API_BASE_URL=http://localhost:8000
