# Copy to .env and fill in to enable live Gemini responses.
# Get a key at https://aistudio.google.com/app/apikey
# Leave blank to run the backend in "demo" mode: /api/chat still answers
# using the local knowledge base (retrieval only, no LLM paraphrasing),
# clearly labeled mode="demo" in every response.
GEMINI_API_KEY=

# Optional — defaults to gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Bhashini (National Language Translation Mission) ---
# Free government API for ASR/translation/TTS across Indian languages.
# Get credentials at https://bhashini.gov.in/ulca/user/signup
# Leave both blank to run without Bhashini: English/Hindi/Tamil keep
# working exactly as before (static translations, browser speech APIs);
# the other 19 scheduled languages will report unsupported via
# GET /api/languages/support and /api/chat will honestly fall back to
# English (inRequestedLanguage: false) instead of pretending.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Optional — only change this if the Bhashini developer portal shows a
# different pipeline ID than the one this defaults to.
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- RAG + FAISS (backend/knowledge/ PDFs) ---
# Leave both blank to use the defaults below. First run of `python
# build_index.py` needs internet access to download the embedding model
# once (~400 MB); after that it's cached locally and runs offline.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Cosine-similarity floor (0-1) below which a retrieved chunk is treated as
# "not a real match" rather than a weak guess. Lower = more permissive.
RAG_MIN_SIMILARITY=0.25
